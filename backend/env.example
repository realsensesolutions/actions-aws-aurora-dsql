# Server Configuration
PORT=8080

# AWS Configuration
AWS_REGION=us-east-1

# Aurora DSQL Configuration (from GitHub Actions outputs)
#
# OBTÉN ESTOS VALORES del GitHub Actions workflow output:
#
# 1. Para DESARROLLO LOCAL (tu Mac/PC):
#    Copia el valor de "Endpoint:" (línea 106 del workflow output)
#    Ejemplo: a1b2c3d4e5f6.dsql.us-east-1.on.aws
#    
#    📊 Cluster Details:
#      Endpoint: a1b2c3d4e5f6.dsql.us-east-1.on.aws  ← USA ESTE
#
# 2. Para PRODUCCIÓN EN VPC (EC2/ECS/Lambda):
#    Copia el valor de "VPC Endpoint DNS:" (línea 116)
#    Ejemplo: vpce-xxxxx.dsql-fnh4.us-east-1.vpce.amazonaws.com
#
#    🌐 Networking:
#      VPC Endpoint DNS: vpce-xxxxx...  ← USA ESTE en VPC
#
# ⚠️ IMPORTANTE: Para local, NO uses el VPC Endpoint (vpce-xxx)
# Si ves "no such host", estás usando el endpoint incorrecto.
DSQL_CLUSTER_ENDPOINT=your-cluster-endpoint.dsql.us-east-1.on.aws
DSQL_DATABASE_NAME=testdb
DSQL_USER=admin

# Authentication Method
# Options: iam (recommended for production) or password
AUTH_METHOD=iam

# If using password authentication (not recommended for production)
# DSQL_PASSWORD=your-password

# Connection Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300

# Application Settings
LOG_LEVEL=info
